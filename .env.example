# Telethon (userbot) — получить на https://my.telegram.org
TELETHON_API_ID=1234567
TELETHON_API_HASH=your_api_hash_here
TELETHON_SESSION=mkx_session

# Канал-источник статистики (формат @statamk10 из ТЗ)
SOURCE_CHANNEL=@statamk10

# python-telegram-bot: токен бота-поставщика сигналов (@BotFather)
TELEGRAM_BOT_TOKEN=123456:ABCDEF
# Куда публиковать сигналы: @username чата/канала или числовой chat_id
SIGNAL_CHAT=@your_signal_group

# База данных
DB_PATH=mkx_bot.db

# Банк и базовые ставки (масштабируются пропорционально балансу, см. balance.py)
START_BALANCE=1000
BET_R1=100
BET_R2=220
BET_R3=480

# Локальная таймзона для фильтров коридоров / «мертвых минут»
TIMEZONE=Europe/Moscow
