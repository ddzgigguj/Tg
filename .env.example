# Telethon (userbot) — берется на https://my.telegram.org
TELETHON_API_ID=1234567
TELETHON_API_HASH=your_api_hash_here
TELETHON_SESSION=mkx_session

# Канал-источник статистики
SOURCE_CHANNEL=@statamk10

# Bot API (python-telegram-bot) — получить у @BotFather
TELEGRAM_BOT_TOKEN=123456:ABCDEF
# Куда публиковать сигналы: @username или числовой chat_id
SIGNAL_CHAT=@your_signal_group

# База данных
DB_PATH=mkx_bot.db

# Стартовый баланс и базовые ставки (можно не трогать — дефолты из ТЗ)
START_BALANCE=1000
BET_R1=100
BET_R2=220
BET_R3=480

# Локальная таймзона для фильтров мертвых минут/коридоров
TIMEZONE=Europe/Moscow
